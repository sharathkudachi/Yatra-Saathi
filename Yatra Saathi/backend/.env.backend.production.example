# ==============================================================================
# Yatra Backend — Production Environment Template (Render / Cloud)
# ==============================================================================
# Set these variables in the Render Dashboard -> Environment Variables.
# NEVER commit real values to version control.

# Database Configuration
# Remote PostgreSQL Database (Recommended for Free Tier Persistence via Neon Serverless Postgres):
# Example: postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL=

# In Render container, APS_DB_ORIGINAL_PATH is relative to repository root or absolute.
APS_DB_ORIGINAL_PATH=/opt/render/project/src/Yatra Saathi/data/original/APS-01.db
APS_DB_ORIGINAL_SHA256=ecc58821ccb7f7d19a23bac157e95ba84521238b40ba52ad568d7932675cae0a

# Working Database:
# If using a Render Persistent Disk mounted at /var/data:
#   APS_DB_PATH=/var/data/aps01_working.db
# If using Render Free Tier (ephemeral storage):
#   APS_DB_PATH=/opt/render/project/src/Yatra Saathi/backend/var/aps01_working.db
APS_DB_PATH=/var/data/aps01_working.db

# Booking & Pricing Engine Configuration
BOOKING_MODE=mock
TAX_RATE_BP=1200
REPLAN_LIMIT=3
CONFIRMATION_TTL_SECONDS=900
AGENT_STATE_MAX_BYTES=1048576
DB_BUSY_TIMEOUT_MS=5000

# Server-Side Cryptographic Secrets (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
HUMAN_TOKEN_SECRET=GENERATE_RANDOM_64_HEX_CHARACTERS
AGENT_TOKEN_SECRET=GENERATE_DIFFERENT_RANDOM_64_HEX_CHARACTERS
AGENT_SERVICE_KEY=GENERATE_SHARED_SECRET_STRING

# AI Agent Service URL:
# If Render Private Service (Paid Starter plan): http://yatra-ai:9000
# If Render Public Web Service (Free plan): https://yatra-ai.onrender.com
AGENT_SERVICE_URL=https://yatra-ai.onrender.com

# Demo User Authorization
DEMO_LOGIN_USER_IDS=usr_demo0001

# CORS Configuration: Comma-separated allowed frontend origins (your Vercel URL)
# Example: https://yatra-concierge.vercel.app,https://yatra-concierge-*-sharathkudachi.vercel.app
CORS_ALLOW_ORIGINS=https://your-yatra-frontend.vercel.app

# Web Push Notifications (Optional - generate with: python -m scripts.make_vapid_keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@yatra.example
NOTIFY_SCHEDULER=0
