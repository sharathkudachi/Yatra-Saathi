# Backend environment (Developer 1). Never give this file to the agent process.
# Original reference database: read-only, hashed and copied only by scripts.
APS_DB_ORIGINAL_PATH=/absolute/path/to/APS-01.db
APS_DB_ORIGINAL_SHA256=ecc58821ccb7f7d19a23bac157e95ba84521238b40ba52ad568d7932675cae0a
# Restorable working copy: the ONLY database the application opens.
APS_DB_PATH=/absolute/path/to/backend/var/aps01_working.db
BOOKING_MODE=mock
TAX_RATE_BP=1200
REPLAN_LIMIT=3
CONFIRMATION_TTL_SECONDS=900
AGENT_STATE_MAX_BYTES=1048576
DB_BUSY_TIMEOUT_MS=5000
# Milestone 3: HTTP layer secrets. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
HUMAN_TOKEN_SECRET=replace-with-a-random-64-hex-secret
AGENT_TOKEN_SECRET=replace-with-a-different-random-64-hex-secret
# Shared secret the backend sends to the agent process when dispatching a run.
AGENT_SERVICE_KEY=replace-with-a-shared-secret
# Developer 2's agent process. Leave unset for a backend-only demo (drive the
# /internal/agent/v1/... routes directly, as tests/fixtures/fake_agent_service.py does).
AGENT_SERVICE_URL=http://localhost:9000
# Comma-separated allow-list for POST /api/v1/auth/demo-login.
DEMO_LOGIN_USER_IDS=usr_demo0001
# Browser origins allowed to call /api/v1 (comma-separated). Unset -> the Vite dev server
# (http://localhost:5173, http://127.0.0.1:5173); empty -> CORS disabled.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Web Push (generate with: python -m scripts.make_vapid_keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@yatra.example
# 1 = send flight departing/landed reminders in the background.
NOTIFY_SCHEDULER=
