# ==============================================================================
# Yatra Frontend — Production Environment Template (Vercel)
# ==============================================================================
# Configure this in the Vercel Project Settings -> Environment Variables.
# NEVER place backend secret keys, passwords, or tokens in frontend variables.

# Direct Backend API URL on Render
# Example: https://your-yatra-backend.onrender.com
# If left empty (""), the frontend uses relative requests with Vercel rewrites.
VITE_API_BASE_URL=https://your-yatra-backend.onrender.com

# Set to false in production to use the live backend API
VITE_USE_MOCK_API=false
