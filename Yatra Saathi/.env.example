# Yatra: every environment variable the app needs, with dummy values.
#
# The three services read three separate files, so the agent never receives the backend's secrets:
#   backend/.env.backend   <- copy the BACKEND block    (template: backend/.env.backend.example)
#   ai/.env.agent          <- copy the AGENT block      (template: ai/.env.agent.example)
#   frontend/.env.local    <- copy the FRONTEND block   (template: frontend/.env.example)
# Generate secrets with: python -c "import secrets; print(secrets.token_hex(32))"

# ============================== BACKEND (backend/.env.backend) ==============================
# The original APS-01 database: read-only, fingerprint-checked, copied by scripts only.
APS_DB_ORIGINAL_PATH=/absolute/path/to/APS-01.db
APS_DB_ORIGINAL_SHA256=ecc58821ccb7f7d19a23bac157e95ba84521238b40ba52ad568d7932675cae0a
# The restorable working copy: the ONLY database the app opens.
APS_DB_PATH=/absolute/path/to/kv-hack2026-tech4ce/backend/var/aps01_working.db
BOOKING_MODE=mock
TAX_RATE_BP=1200                     # 12% tax, in basis points
REPLAN_LIMIT=3                       # max re-plans after a refusal
CONFIRMATION_TTL_SECONDS=900         # an approval request expires after 15 minutes
AGENT_STATE_MAX_BYTES=1048576
DB_BUSY_TIMEOUT_MS=5000
HUMAN_TOKEN_SECRET=replace-with-a-random-64-hex-secret
AGENT_TOKEN_SECRET=replace-with-a-different-random-64-hex-secret
AGENT_SERVICE_KEY=replace-with-a-shared-secret          # must match the AGENT block
AGENT_SERVICE_URL=http://localhost:9000
DEMO_LOGIN_USER_IDS=usr_demo0001
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Web Push (optional; generate with: python -m scripts.make_vapid_keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@yatra.example
NOTIFY_SCHEDULER=                    # 1 = send flight departing/landed reminders in the background

# =============================== AGENT (ai/.env.agent) ======================================
# No database path and no backend secrets: the agent reaches the backend over HTTP only.
BACKEND_URL=http://localhost:8000
AGENT_SERVICE_KEY=replace-with-a-shared-secret          # must match the BACKEND block
GROQ_API_KEY=                        # optional; without it the agent is fully rule-based
TRAVEL_AGENT_LLM_MODEL=openai/gpt-oss-120b
TRAVEL_AGENT_DISABLE_LLM=            # 1 = force rule-based mode (tests use this)

# ================== TESTS / OFFLINE AGENT ONLY (never give this to the agent service) ========
# The agent's standalone mode reads the original read-only; tests set it from APS_DB_ORIGINAL_PATH.
APS01_DB_PATH=/absolute/path/to/APS-01.db

# ============================ FRONTEND (frontend/.env.local) ================================
VITE_USE_MOCK_API=false              # false = talk to the real backend
VITE_API_BASE_URL=http://localhost:8000
