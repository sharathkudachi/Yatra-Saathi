# ==============================================================================
# Yatra AI Agent — Production Environment Template (Render / Cloud)
# ==============================================================================
# Set these variables in the Render Dashboard -> Environment Variables.
# NEVER commit real values to version control.

# Backend API Endpoint:
# The AI agent communicates back to the backend over HTTP.
# On Render: https://your-yatra-backend.onrender.com (or http://yatra-backend:8000 if on private network)
BACKEND_URL=https://your-yatra-backend.onrender.com

# Shared Service Secret (Must exactly match AGENT_SERVICE_KEY in backend)
AGENT_SERVICE_KEY=GENERATE_SHARED_SECRET_STRING

# LLM Provider Configuration
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
TRAVEL_AGENT_LLM_MODEL=openai/gpt-oss-120b
TRAVEL_AGENT_DISABLE_LLM=0
