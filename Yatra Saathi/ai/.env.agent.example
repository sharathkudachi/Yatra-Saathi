# Agent process environment. No database path, no backend secrets -- the agent
# talks to the backend only over HTTP with the session-scoped token it's handed.
BACKEND_URL=http://localhost:8000
AGENT_SERVICE_KEY=replace-with-a-shared-secret
# LLM provider (optional -- rule-based extraction is used when unset):
GROQ_API_KEY=replace-with-your-groq-api-key
TRAVEL_AGENT_LLM_MODEL=openai/gpt-oss-120b
TRAVEL_AGENT_DISABLE_LLM=
